'use client';
import { useState } from 'react';

export default function PasswordPair({
  password, setPassword, confirm, setConfirm,
}: {
  password: string; setPassword: (v: string) => void;
  confirm: string; setConfirm: (v: string) => void;
}) {
  const [touched, setTouched] = useState(false);
  const mismatch = touched && confirm.length > 0 && password !== confirm;

  return (
    <>
      <input
        type="password" required value={password}
        onChange={(e) => setPassword(e.target.value)}
        placeholder="Password"
        className="w-full rounded-lg border border-gray-300 px-4 py-3 text-base
                   focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none"
      />
      <input
        type="password" required value={confirm}
        onChange={(e) => { setConfirm(e.target.value); setTouched(true); }}
        placeholder="Confirm password"
        className={`w-full rounded-lg border px-4 py-3 text-base outline-none
          ${mismatch ? 'border-red-500 focus:ring-red-200' : 'border-gray-300 focus:border-indigo-500 focus:ring-indigo-200'}
          focus:ring-2`}
      />
      {mismatch && <p className="text-red-600 text-sm">Passwords do not match</p>}
    </>
  );
}
